  "info": {
    "_postman_id": "bb5605a1-9283-4d89-9bc4-c14c6e0cd2c9",
    "name": "Blotato Accounts Visuals API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "The Blotato API lets you upload media, publish and schedule posts to social platforms (Twitter/X, Instagram, LinkedIn, Facebook, TikTok, Pinterest, Threads, Bluesky, YouTube), generate AI videos and visuals from templates, and retrieve connected accounts. All requests are authenticated with a blotato-api-key header.\n\nContact Support:\n Name: Blotato Support",
      "type": "text/plain"
    }
  }
