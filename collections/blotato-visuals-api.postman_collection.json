              "mode": "raw",
              "raw": "{\n  \"templateId\": \"<string>\",\n  \"inputs\": \"<object>\",\n  \"prompt\": \"<string>\",\n  \"render\": \"<boolean>\",\n  \"isDraft\": \"<boolean>\",\n  \"title\": \"<string>\",\n  \"useBrandKit\": \"<boolean>\"\n}",
